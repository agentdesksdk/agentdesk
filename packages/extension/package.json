  },
  "dependencies": {
    "@agentdesksdk/webmcp": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
