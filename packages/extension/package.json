{
  "name": "@agentdesksdk/extension",
  "version": "0.0.1",
  "private": true,
  "description": "AgentDesk Universal: the extension-context CapabilityProvider and the page bridge it governs.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
